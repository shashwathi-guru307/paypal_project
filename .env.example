# ---------------------------------------------------------------------------
# EscrowPilot environment template
# Copy to .env and fill in. .env is gitignored - never commit real values.
#    cp .env.example .env
# ---------------------------------------------------------------------------

# --- PayPal (SANDBOX ONLY - the app refuses to start against live) ----------
# App: developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: default freelancer receiver for scripts/paypal_smoke_test.py.
# Use the email of a *sandbox Personal account* you created so the payout can
# be claimed and reach SUCCESS.
PAYPAL_SANDBOX_RECEIVER_EMAIL=

# --- Firebase / Firestore ---------------------------------------------------
# Download the service account key: Firebase console > Project settings >
# Service accounts > Generate new private key. Keep it OUTSIDE git (secrets/).
FIREBASE_CREDENTIALS_PATH=./secrets/serviceAccountKey.json
FIREBASE_PROJECT_ID=

# --- LLM --------------------------------------------------------------------
# The reviewer in backend/llm.py only advises; a human still approves or rejects.
# provider: anthropic (default) or gemini. Anthropic uses the official SDK;
# gemini uses the public REST API over the standard library, so it needs no
# extra package. Another provider is one function in backend/llm.py plus an
# entry in its PROVIDERS map - no other changes.
LLM_PROVIDER=anthropic
# API key for the provider above. Never commit it. Without a key the app still
# runs: reviews fall back to "Automated review failed. Manual review needed."
LLM_API_KEY=
# Model name sent to the provider. Required - backend/llm.py deliberately has no
# built-in default, so this is the one place to change models. Anthropic examples:
#   claude-sonnet-4-5            balanced quality/cost (used by scripts/review_samples.py checks)
#   claude-haiku-4-5-20251001    cheaper and faster, weaker at spotting missing work
# Gemini examples:
#   gemini-3.5-flash            fast, reliable on the free tier
# Check your provider's current model list before changing this: a model your
# key cannot use makes every review fall back to manual review.
LLM_MODEL=claude-sonnet-4-5

# --- App --------------------------------------------------------------------
# Where PayPal sends the buyer back after approving / cancelling (the Vite dev server)
FRONTEND_URL=http://localhost:5173
# Hard server-side cap per task, USD
MAX_TASK_AMOUNT=100.00
